# Server-only Supabase credentials. Never expose these to clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strong, random token used by the management API (also set TGGLR_API_SECRET
# for the Discord bot with the SAME value).
LICENSE_ADMIN_TOKEN=replace-with-a-long-random-token

# Discord bot (bot/.env holds these too; keep them in sync or centralize here)
# DISCORD_BOT_TOKEN=your-new-bot-token
# DISCORD_APPLICATION_ID=1569489271025569903
# DISCORD_PUBLIC_KEY=public-key-from-developer-portal
# ADMIN_USER_IDS=123456789012345678
# TGGLR_API_URL=https://tgglr.vercel.app
# TGGLR_API_SECRET=same-as-LICENSE_ADMIN_TOKEN
